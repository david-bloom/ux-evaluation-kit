{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david-bloom/ux-evaluation-kit/schemas/run-charter.schema.json",
  "title": "UX Run Charter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "mode", "target", "boundaries", "users", "task", "usability_priorities", "lenses", "execution", "evidence", "excluded"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["proposed", "frozen", "amended"]},
    "mode": {"enum": ["quick", "standard", "deep"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "surface", "version"],
      "properties": {"product": {"type": "string"}, "surface": {"type": "string"}, "version": {"type": "string"}}
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "users": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": {"$ref": "#/$defs/userModel"},
        "secondary": {"type": "array", "items": {"$ref": "#/$defs/userModel"}}
      }
    },
    "task": {"$ref": "#/$defs/taskModel"},
    "usability_priorities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "secondary": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "specialist", "excluded_with_reason"],
      "properties": {
        "baseline": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "specialist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "excluded_with_reason": {"type": "array", "items": {"type": "object", "required": ["lens_id", "reason"], "properties": {"lens_id": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_mode", "models", "runs_per_model", "skeptic", "synthesis"],
      "properties": {
        "evidence_mode": {"enum": ["interactive", "static", "trace_review", "mixed"]},
        "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runs_per_model": {"type": "integer", "minimum": 1},
        "skeptic": {"enum": ["inline_separate_pass", "fresh_context"]},
        "synthesis": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "distinguish_basis", "preserve_disagreement"],
      "properties": {
        "sources": {"type": "array", "items": {"type": "string"}},
        "distinguish_basis": {"const": true},
        "preserve_disagreement": {"const": true}
      }
    },
    "excluded": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "userModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "domain_expertise", "product_expertise", "frequency", "motivation", "time_pressure", "technical_confidence", "mental_models", "terminology", "accessibility_constraints"],
      "properties": {
        "id": {"type": "string"}, "role": {"type": "string"}, "domain_expertise": {"type": "string"}, "product_expertise": {"type": "string"}, "frequency": {"type": "string"}, "motivation": {"type": "string"}, "time_pressure": {"type": "string"}, "technical_confidence": {"type": "string"}, "mental_models": {"type": "array", "items": {"type": "string"}}, "terminology": {"type": "array", "items": {"type": "string"}}, "accessibility_constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "taskModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "goal", "starting_state", "goal_state", "information_available", "information_withheld", "frequency", "failure_consequences", "time_sensitivity", "criticality", "acceptable_paths"],
      "properties": {
        "id": {"type": "string"}, "goal": {"type": "string"}, "starting_state": {"type": "string"}, "goal_state": {"type": "string"}, "information_available": {"type": "array", "items": {"type": "string"}}, "information_withheld": {"type": "array", "items": {"type": "string"}}, "frequency": {"type": "string"}, "failure_consequences": {"type": "string"}, "time_sensitivity": {"type": "string"}, "criticality": {"enum": ["low", "medium", "high"]}, "acceptable_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
