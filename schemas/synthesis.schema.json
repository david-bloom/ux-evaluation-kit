{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/david-bloom/ux-evaluation-kit/schemas/synthesis.schema.json",
  "title": "UX Run Synthesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthesis_id", "run_ids", "compatibility_notes", "groups", "limitations"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "synthesis_id": {"type": "string"},
    "run_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
    "compatibility_notes": {"type": "string"},
    "groups": {"type": "array", "items": {"type": "object", "required": ["phenomenon", "classification", "finding_ids", "interpretation", "follow_up"], "properties": {"phenomenon": {"type": "string"}, "classification": {"enum": ["convergent", "divergent_interpretation", "condition_sensitive", "model_or_run_sensitive", "unresolved"]}, "finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "interpretation": {"type": "string"}, "follow_up": {"type": "string"}}, "additionalProperties": false}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
